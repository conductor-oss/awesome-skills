{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-payload.schema.json",
  "title": "GTM Mavericks Intake Payload",
  "type": "object",
  "required": ["mode", "product", "deliverables", "output_formats", "persona_library_version"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Caller-supplied run identifier, used in bundle output and filesystem layout"
    },
    "mode": { "enum": ["new_product", "reposition", "campaign"] },
    "product": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "icp_hypothesis": { "type": ["string", "null"] },
    "corpus": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "URLs that the discovery sub-workflow will fetch via HTTP and feed into the audit/synthesis prompts"
        },
        "mcps_available": { "type": "array", "items": { "type": "string" } }
      }
    },
    "research_depth": {
      "enum": ["standard", "deep"],
      "default": "standard",
      "description": "standard = 1 synthesis pass with hardened prompts. deep = synthesis runs draft → critic → reviser refinement (3 LLM calls per phase). Both modes fetch corpus URLs."
    },
    "search_provider": {
      "type": ["string", "null"],
      "enum": ["brave", "serper", "google", null],
      "default": null,
      "description": "If set AND the corresponding API key env var is configured, the discovery phase additionally issues web search queries via this provider"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "enum": ["icp_one_pager", "positioning", "messaging_house", "sales_playbook", "landing_copy", "ad_copy", "outbound_sequences", "ninety_day_plan"]
      },
      "minItems": 1
    },
    "output_formats": {
      "type": "array",
      "items": { "enum": ["markdown", "pdf", "slides"] },
      "minItems": 1
    },
    "notifications": {
      "type": "object",
      "properties": {
        "email": { "type": ["string", "null"], "format": "email" },
        "slack_webhook": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "persona_library_version": { "type": "string", "pattern": "^v\\d+$" }
  }
}

.gtm/
gtm-output/

# Test fixtures
test/
tests/
__tests__/

# CI
.github/
.gitlab-ci.yml

# Docs that live in the parent repo, not the package
docs/
evals/results/
evals/bundle/fixtures/*.bundle.json
!evals/bundle/fixtures/example.bundle.json
